---
// A panel that leads to one section of the site: an icon, the section's name, what is in it,
// and a link. The icons are the files in src/assets/icons, named without `.svg`.
interface Props {
  title: string;
  icon: string;
  link: string;
  action: string;
}

const icons = import.meta.glob<string>('../assets/icons/*.svg', { query: '?raw', import: 'default', eager: true });
const { title, icon, link, action } = Astro.props;
const svg = icons[`../assets/icons/${icon}.svg`];
const arrow = icons['../assets/icons/arrow-right.svg'];
if (!svg) throw new Error(`No icon named "${icon}" in src/assets/icons.`);
---

<article class="panel">
  <span class="icon" aria-hidden="true" set:html={svg} />
  <p class="title">{title}</p>
  <div class="body"><slot /></div>
  <a class="action" href={link}>
    {action}
    <span class="arrow" aria-hidden="true" set:html={arrow} />
  </a>
</article>

<style>
  .panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    background-color: var(--sl-color-gray-6);
  }
  .icon {
    display: flex;
    align-self: flex-start;
    padding: 0.4rem;
    border-radius: 0.4rem;
    background-color: var(--sl-color-gray-5);
    color: var(--sl-color-accent-high);
  }
  .icon :global(svg) {
    width: 2rem;
    height: 2rem;
  }
  .title {
    margin: 0;
    font-size: var(--sl-text-h4);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
  }
  .body {
    flex: 1;
    color: var(--sl-color-gray-2);
  }
  .body :global(p) {
    margin: 0;
  }
  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    align-self: flex-start;
    font-weight: 600;
    text-decoration: none;
    color: var(--sl-color-text-accent);
  }
  .action:hover {
    text-decoration: underline;
  }
  .arrow {
    display: flex;
  }
  .arrow :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
